/* SF32LB58 a128r32n1 memory layout (migrated to openvela NuttX):
 *
 *   Flash (XIP):  QSPI2 NOR 1 MB at 0x12000000 (bootloader @ 0x12000000, app @ 0x12010000)
 *   SRAM:         RAM0-RAM5 = 1.5 MB (0x20000000 - 0x20180000)
 *   PSRAM:        MPI1 OPSRAM = 32 MB (0x60200000, after 2MB reserved)
 *
 * Migration notes (sf32lb52 SDK → openvela pattern):
 *   - Removed: .retm_data, .itcm_code/.itcm_data, .retm_bss/.itcm_bss,
 *              .RW_IRAM0, .rom_ex, .rom2/.rom3, .stack/.heap, ROM_EX/ROM2/ROM3
 *   - Added:   .ramfunc (flash driver), .ram_vectors, .tdata/.tbss,
 *              /DISCARD/ build-id, NuttX startup symbols
 *   - .ramfunc covers critical code that must run from SRAM (flash erase/write)
 */

MEMORY
{
  code (rx)  : ORIGIN = 0x10000000, LENGTH = 4M     /* 4MB occupied for code */
  sram (rwx)  : ORIGIN = 0x20000000, LENGTH = 1536K    /* RAM0-RAM5: 128+128+256+512+512 KB */
  psram (rwx) : ORIGIN = 0x60400000, LENGTH = 16M      /* MPI1 qPSRAM, after 4MB reserved for code */
  psram2 (rwx) : ORIGIN = 0x62000000, LENGTH = 16M      /* MPI2 qPSRAM */
}

OUTPUT_ARCH(arm)
EXTERN(_vectors)
/* Provide __Vectors alias for SystemInit() compatibility */
__Vectors = _vectors;
ENTRY(_stext)

SECTIONS
{
    /* Discard build-id to ensure vectors start at flash base */
    /DISCARD/ : {
        *(.note.gnu.build-id)
    }

    .text : {
        _stext = ABSOLUTE(.);
        /* Ensure vector table is properly aligned (must be at flash start) */
        . = ALIGN(512);
        KEEP(*(.vectors))
        . = ALIGN(4);
        *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        *(.rodata .rodata.*)
        *(.gnu.linkonce.t.*)
        *(.glue_7)
        *(.glue_7t)
        *(.got)
        *(.gcc_except_table)
        *(.gnu.linkonce.r.*)

        KEEP(*(.init))
        KEEP(*(.fini))

        /* Section information for finsh shell */
        . = ALIGN(4);
        __fsymtab_start = .;
        KEEP(*(FSymTab))
        __fsymtab_end = .;

        . = ALIGN(4);
        __vsymtab_start = .;
        KEEP(*(VSymTab))
        __vsymtab_end = .;

        . = ALIGN(4);
        __rt_utest_tc_tab_start = .;
        KEEP(*(UtestTcTab))
        __rt_utest_tc_tab_end = .;

        /* Section information for initial */
        . = ALIGN(4);
        __rt_init_start = .;
        KEEP(*(SORT(.rti_fn*)))
        __rt_init_end = .;

        . = ALIGN(4);
        __sifli_reg_start__ = .;
        KEEP(*(SORT(.sifli_reg*)))
        __sifli_reg_end__ = .;

        . = ALIGN(4);
        __bt_sifli_reg_start__ = .;
        KEEP(*(SORT(.bt_sifli_reg*)))
        __bt_sifli_reg_end__ = .;

        /* Section information for modules */
        . = ALIGN(4);
        __rtmsymtab_start = .;
        KEEP(*(RTMSymTab))
        __rtmsymtab_end = .;

        /* Section information for LCD drivers */
        . = ALIGN(4);
        LcdDriverDescTab_start = .;
        KEEP(*(LcdDriverDescTab))
        LcdDriverDescTab_end = .;

        . = ALIGN(4);
        __usbh_class_info_start__ = .;
        KEEP(*(.usbh_class_info))
        __usbh_class_info_end__ = .;

        . = ALIGN(4);
        __nand_cfg_db_start__ = .;
        KEEP(*(.nand_cfg_db))
        __nand_cfg_db_end__ = .;

        KEEP(*(.eh_frame*))
        _etext = ABSOLUTE(.);
    } > code

    .ARM.extab : {
        *(.ARM.extab* .gnu.linkonce.armextab.*)
    } > code

    __exidx_start = ABSOLUTE(.);
    .ARM.exidx : {
        *(.ARM.exidx* .gnu.linkonce.armexidx.*)
    } > code
    __exidx_end = ABSOLUTE(.);

    .copy.table : {
        . = ALIGN(4);
        __copy_table_start__ = .;
        LONG (LOADADDR(.data))
        LONG (ADDR(.data))
        LONG (SIZEOF(.data))
        __copy_table_end__ = .;
    } > code

    .zero.table : {
        . = ALIGN(4);
        __zero_table_start__ = .;
        LONG (__bss_start__)
        LONG (__bss_end__ - __bss_start__)
        __zero_table_end__ = .;
    } > code

    .tdata : {
        _stdata = ABSOLUTE(.);
        *(.tdata .tdata.* .gnu.linkonce.td.*);
        _etdata = ABSOLUTE(.);
    } > code

    .tbss : {
        _stbss = ABSOLUTE(.);
        *(.tbss .tbss.* .gnu.linkonce.tb.* .tcommon);
        _etbss = ABSOLUTE(.);
    } > code

    _eronly = ABSOLUTE(.);
    __etext = ALIGN(4);

    .ram_vectors : {
        *(.ram_vectors)
    } > sram

    .data : {
        _sdata = ABSOLUTE(.);
        __data_start__ = .;
        *(vtable)
        *(.data)
        *(.data.*)
        *(.gnu.linkonce.d.*)
        *(.l1_ret_data_*)
        CONSTRUCTORS

        . = ALIGN(4);
        /* preinit data */
        PROVIDE_HIDDEN (__preinit_array_start = .);
        KEEP(*(.preinit_array))
        PROVIDE_HIDDEN (__preinit_array_end = .);

        . = ALIGN(4);
        /* init data */
        _sinit = ABSOLUTE(.);
        PROVIDE(__ctors_start__ = .);
        PROVIDE_HIDDEN (__init_array_start = .);
        KEEP(*(SORT(.ctors.*)))
        KEEP(*(.ctors))
        KEEP(*(SORT(.init_array.*)))
        KEEP(*(.init_array))
        _einit = ABSOLUTE(.);
        PROVIDE_HIDDEN (__init_array_end = .);
        PROVIDE(__ctors_end__ = .);

        . = ALIGN(4);
        /* fini data */
        PROVIDE(__dtors_start__ = .);
        PROVIDE_HIDDEN (__fini_array_start = .);
        KEEP(*(SORT(.dtors.*)))
        KEEP(*(.dtors))
        KEEP(*(SORT(.fini_array.*)))
        KEEP(*(.fini_array))
        PROVIDE_HIDDEN (__fini_array_end = .);
        PROVIDE(__dtors_end__ = .);

        KEEP(*(.jcr*))
        . = ALIGN(4);
        __data_end__ = .;
        _edata = ABSOLUTE(.);
    } > sram AT > code

    .ramfunc : {
        . = ALIGN(4);
        _sramfunc = ABSOLUTE(.);
        *(.ramfunc .ramfunc.*)
        . = ALIGN(4);
        _eramfunc = ABSOLUTE(.);
    } > sram AT > code

    _siramfunc = LOADADDR(.ramfunc);

    .bss : {
        . = ALIGN(4);
        _sbss = ABSOLUTE(.);
        __bss_start__ = .;
        *(.bss)
        *(.bss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
        _ebss = ABSOLUTE(.);
    } > sram

    . = ALIGN(4);
    __end__ = .;
    PROVIDE(end = .);
    PROVIDE(_end = .);

    /* PSRAM sections for cache-aligned data */
    .RW_PSRAM1 : {
        . = ALIGN(4);
        __rw_psram1_start__ = .;
        *(.*l2_ret_data_*)
        *(.*l2_ret_bss_*)
        *(.*l2_cache_ret_data_*)
        *(.*l2_cache_ret_bss_*)
        . = ALIGN(4);
        __rw_psram1_end__ = .;
    } > psram

    .RW_PSRAM_NON_RET : {
        . = ALIGN(32);  /* Cache-line aligned */
        __RW_PSRAM_NON_RET_start__ = .;
        *(.nand_cache)
        *(.*l2_cache_non_ret_data_*)
        *(.*l2_cache_non_ret_bss_*)
        . = ALIGN(4);
        __RW_PSRAM_NON_RET_end__ = .;
    } > psram

    /* Stabs debugging sections. */
    .stab 0 : { *(.stab) }
    .stabstr 0 : { *(.stabstr) }
    .stab.excl 0 : { *(.stab.excl) }
    .stab.exclstr 0 : { *(.stab.exclstr) }
    .stab.index 0 : { *(.stab.index) }
    .stab.indexstr 0 : { *(.stab.indexstr) }
    .comment 0 : { *(.comment) }
    .debug_abbrev 0 : { *(.debug_abbrev) }
    .debug_info 0 : { *(.debug_info) }
    .debug_line 0 : { *(.debug_line) }
    .debug_pubnames 0 : { *(.debug_pubnames) }
    .debug_aranges 0 : { *(.debug_aranges) }
}
