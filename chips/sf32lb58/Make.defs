# SF32LB58 is Cortex-M33 (ARMv8-M)
include armv8-m/Make.defs

# Chip-local C sources
CHIP_CSRCS += sifli_start.c sifli_irq.c sifli_uart.c sifli_lowput.c
CHIP_CSRCS += sifli_oneshot.c sf32lb58_allocateheap.c sifli_gpio.c
CHIP_CSRCS += sifli_i2c.c sifli_spi.c

ifeq ($(CONFIG_ADC),y)
CHIP_CSRCS += sf32lb_adc.c
endif

ifeq ($(CONFIG_RTC),y)
CHIP_CSRCS += sf32lb_rtc.c
endif

ifeq ($(CONFIG_WATCHDOG),y)
CHIP_CSRCS += sf32lb_iwdg.c
endif

ifeq ($(CONFIG_MTD),y)
CHIP_CSRCS += sf32lb_flash.c
endif

ifeq ($(CONFIG_TIMER),y)
CHIP_CSRCS += sf32lb_timer.c
endif

ifeq ($(CONFIG_PWM),y)
CHIP_CSRCS += sf32lb_pwm.c
endif

ifeq ($(CONFIG_UART_BTH4),y)
CHIP_CSRCS += sf32lb58_bt_adapter.c sf32lb58_bth4.c
CHIP_CSRCS += lcpu_img_58x_3sco.c
CHIP_CSRCS += ../drivers/cmsis/sf32lb58x/lcpu_patch.c
CHIP_CSRCS += ../drivers/cmsis/sf32lb58x/bf0_lcpu_init.c
endif

include chip/ipc_queue/Make.defs
